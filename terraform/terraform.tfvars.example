# =============================================================================
# Example variable values — copy to terraform.tfvars and customize
# =============================================================================

project_name = "data-distribution-hub"
hub_region   = "us-east-1"

source_bucket_arn          = "arn:aws:s3:::my-central-data-lake"
source_bucket_subdirectory = "/"

alert_email_addresses = [
  "platform-team@example.com",
  "oncall@example.com"
]

default_tags = {
  ManagedBy   = "terraform"
  Project     = "data-distribution-hub"
  Environment = "production"
}

# -----------------------------------------------------------------------------
# Spoke configurations
# -----------------------------------------------------------------------------
spokes = {
  dev = {
    account_id = "111111111111"
    bucket_arn = "arn:aws:s3:::data-distribution-dev"
    role_arn   = "arn:aws:iam::111111111111:role/TerraformProvisioningRole"
    schedule   = "cron(0 */6 * * ? *)" # Every 6 hours
  }

  staging = {
    account_id       = "222222222222"
    bucket_arn       = "arn:aws:s3:::data-distribution-staging"
    role_arn         = "arn:aws:iam::222222222222:role/TerraformProvisioningRole"
    schedule         = "cron(0 0 * * ? *)" # Daily at midnight UTC
    include_patterns = "/datasets/shared/*|/config/*"
  }

  prod = {
    account_id       = "333333333333"
    bucket_arn       = "arn:aws:s3:::data-distribution-prod"
    role_arn         = "arn:aws:iam::333333333333:role/TerraformProvisioningRole"
    schedule         = "cron(0 */2 * * ? *)" # Every 2 hours
    bandwidth_limit  = 104857600              # 100 MB/s
    exclude_patterns = "/tmp/*|/staging/*"
  }

  analytics = {
    account_id    = "444444444444"
    bucket_arn    = "arn:aws:s3:::data-distribution-analytics"
    role_arn      = "arn:aws:iam::444444444444:role/TerraformProvisioningRole"
    schedule      = "cron(0 6 * * ? *)" # Daily at 6 AM UTC
    storage_class = "STANDARD_IA"
    subdirectory  = "/analytics-ingest/"
  }
}
